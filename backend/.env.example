# Environment Configuration for AI TRAITORS
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="AI TRAITORS"
API_V1_STR="/api/v1"

# Security & Tokens
# Generate a unique value for every deployment. Never use the example value in production.
SECRET_KEY="generate-a-unique-random-secret-at-least-32-bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local development with zero external dependencies, SQLite can be used:
DATABASE_URL="sqlite+aiosqlite:///./ai_traitors.db"
# For production PostgreSQL + pgvector:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/ai_traitors"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://your-game-domain.example"

# AI & LLM Provider Configuration
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_TEMPERATURE=0.7
